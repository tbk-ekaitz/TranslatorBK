# Multi-Model Translation Service - Environment Configuration
# Copy this file to .env and configure your API keys

# =============================================================================
# API Keys (Optional - only needed if using external API models)
# =============================================================================

# OpenAI API Key
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google AI API Key
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# =============================================================================
# Ollama Configuration
# =============================================================================

# Ollama base URL (default: http://ollama:11434 for Docker, http://localhost:11434 for local)
OLLAMA_BASE_URL=http://ollama:11434

# =============================================================================
# Application Settings
# =============================================================================

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Enable translation caching
CACHE_ENABLED=true

# Enable translation logging
LOG_TRANSLATIONS=true

# =============================================================================
# Evaluation Settings
# =============================================================================

# Evaluation method: consensus, scoring, weighted_vote
EVALUATION_METHOD=consensus

# Consensus threshold for similarity grouping (0.0 - 1.0)
CONSENSUS_THRESHOLD=0.7
